        print("⏳ Running Stress Scenario Simulation (Post Zero-Day Exploit Drift)...")
        ai_large_drift, mean_large_drift, std_large_drift = simulate_environment_risk(modified_json[large_surface_img])
        ai_small_drift, mean_small_drift, std_small_drift = simulate_environment_risk(modified_json[small_surface_img])

        # STEP 6: Render Scientific Comparative Report
        print("\n" + "="*75)
        print(f"🔬 EXPERIMENT REPORT: CONTROLLED EXPLOIT DRIFT STRESS TEST ({target_cve})")
        print("="*75)
        print(f"ENVIRONMENT: {large_surface_img} (LARGE SURFACE - FULL)")
        print(f"  • Aggregate Exposure ($A_i$):     {ai_large_base:7.4f}  -->  {ai_large_drift:7.4f}  (Shift: {ai_large_drift - ai_large_base:+.4f})")
        print(f"  • Uncertainty Window ($2 \\times h_i$):   { (ai_large_base*3.9):7.4f}  -->  { (ai_large_drift*3.9):7.4f}  (Expansion: { (ai_large_drift*3.9) - (ai_large_base*3.9):+.4f})")
        print(f"  • Expected Mean Risk ($\\mathbb{{E}}[R]$):   {mean_large_base:7.4f}  -->  {mean_large_drift:7.4f}  (Risk Jump: {mean_large_drift - mean_large_base:+.4f})")
        print(f"  • Volatility/Instability ($\\sigma$):   {std_large_base:7.4f}  -->  {std_large_drift:7.4f}  (Noise Increase: {std_large_drift - std_large_base:+.4f})")
        print("-"*75)
        print(f"ENVIRONMENT: {small_surface_img} (SMALL SURFACE - SLIM)")
        print(f"  • Aggregate Exposure ($A_i$):     {ai_small_base:7.4f}  -->  {ai_small_drift:7.4f}  (Shift: {ai_small_drift - ai_small_base:+.4f})")
        print(f"  • Uncertainty Window ($2 \\times h_i$):   { (ai_small_base*3.9):7.4f}  -->  { (ai_small_drift*3.9):7.4f}  (Expansion: { (ai_small_drift*3.9) - (ai_small_base*3.9):+.4f})")
