import json
import math
import numpy as np
from pathlib import Path

def compute_aggregate_exposure(epss_list: list[float]) -> float:
    """Calculates Ai: 1 - P(1 - epss)"""
    if not epss_list:
        return 0.0
    return float(1.0 - np.prod([1.0 - float(e) for e in epss_list]))

def calculate_cvss_base_vectorized(impact: float, exploitability_array: np.ndarray, scope_changed: bool) -> np.ndarray:
    """Official CVSS v3.1 equations vectorized with RoundUp."""
    if impact <= 0:
        return np.zeros_like(exploitability_array)
    if not scope_changed:
        scores = np.minimum(impact + exploitability_array, 10.0)
    else:
        scores = np.minimum(1.08 * (impact + exploitability_array), 10.0)
    scores_int = np.round(scores * 100000).astype(int)
    return np.where(scores_int % 10000 == 0, np.round(scores, 1), np.ceil(np.round(scores, 9) * 10.0) / 10.0)

def simulate_environment_risk(cves: list[dict], target_samples: int = 5000) -> tuple[float, float, float]:
    """Runs a targeted Monte Carlo simulation for a single environment profile."""
    if not cves:
        return 0.0, 0.0, 0.0
        
    rng = np.random.default_rng(seed=42)
    epss_list = [cve["epss"] for cve in cves]
    ai = compute_aggregate_exposure(epss_list)
    hi = (1.0 * ai * 3.9) / 2.0  # lambda = 1.0
    
    image_risk_accumulated = np.zeros(target_samples)
    
    for cve in cves:
        iv = cve["impact_subscore"]
        xv = cve["exploitability_subscore"]
        sv = cve["scope_changed"]
        ev = cve["epss"]
        
        lower = max(0.0, xv - hi)
        upper = min(3.9, xv + hi)
        
        if lower == upper:
            expl_samples = np.full(target_samples, lower)
        else:
            expl_samples = rng.triangular(lower, xv, upper, size=target_samples)
            
        simulated_base_scores = calculate_cvss_base_vectorized(iv, expl_samples, sv)
        image_risk_accumulated += (ev * simulated_base_scores)
        
    return ai, float(np.mean(image_risk_accumulated)), float(np.std(image_risk_accumulated))

def main():
    data_dir = Path("aggregated_summary")
    profile_path = data_dir / "environmental_cve_profiles.json"

    if not profile_path.exists():
        print(f"❌ Error: The file '{profile_path}' does not exist. Please extract data first.")
        return

    # Load complete backup into RAM to ensure data isolation and safety
    with open(profile_path, "r", encoding="utf-8") as f:
        original_json_backup = json.load(f)

    print("📥 Environmental profile backup successfully loaded into memory.")

    try:
        # STEP 1: Identify the largest surface image (Full)
        sorted_images = sorted(original_json_backup.keys(), key=lambda k: len(original_json_backup[k]), reverse=True)
        large_surface_img = sorted_images[0]
        large_cves = {c["cve"] for c in original_json_backup[large_surface_img] if c["cve"].startswith("CVE-")}

        # STEP 2: Dynamically look for a Slim/smaller image that SHARES at least one CVE with the large one
        small_surface_img = None
        target_cve = None

        # Filter and scan small images (preferring slim profiles) from smallest to largest
        small_candidates = [img for img in reversed(sorted_images) if "slim" in img.lower() and len(original_json_backup[img]) > 0]
        
        for img in small_candidates:
            img_cves = {c["cve"] for c in original_json_backup[img] if c["cve"].startswith("CVE-")}
            shared_cves = large_cves.intersection(img_cves)
            if shared_cves:
                small_surface_img = img
                target_cve = list(shared_cves)[0]  # Select the first shared vulnerability found
                break

        # Fallback if no slim image matches, scan any non-empty smaller image
        if not target_cve:
            for img in reversed(sorted_images):
                if img == large_surface_img or len(original_json_backup[img]) == 0:
                    continue
                img_cves = {c["cve"] for c in original_json_backup[img] if c["cve"].startswith("CVE-")}
                shared_cves = large_cves.intersection(img_cves)
                if shared_cves:
                    small_surface_img = img
                    target_cve = list(shared_cves)[0]
                    break

        if not target_cve:
            print("⚠️ Critical Error: Could not find any shared CVE between large and small images to execute a fair test.")
            return

        print(f"🎯 Shared Vulnerability Isolated: {target_cve}")
        print(f"🏗️  Large Surface Environment (Full): {large_surface_img} ({len(original_json_backup[large_surface_img])} CVEs)")
        print(f"🛡️  Small Surface Environment (Slim): {small_surface_img} ({len(original_json_backup[small_surface_img])} CVEs)")

        # STEP 3: Scenario A Simulation - Baseline (Original Scenario)
        print("\n⏳ Running Baseline Simulation (Original Scenario)...")
        ai_large_base, mean_large_base, std_large_base = simulate_environment_risk(original_json_backup[large_surface_img])
        ai_small_base, mean_small_base, std_small_base = simulate_environment_risk(original_json_backup[small_surface_img])

        # STEP 4: Inject Zero-Day Crisis (Temporarily boost target CVE EPSS to 0.85)
